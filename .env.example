# Campus Coin - Unified Environment Configuration Template
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campuscoin?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_API_BASE_URL=/api

# Email Configuration (Optional SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Initial Admin Credentials
ADMIN_EMAIL=admin@campuscoin.com
ADMIN_PASSWORD=Admin@123

# Caching Configuration (Redis optional)
REDIS_URL=redis://127.0.0.1:6379

# AI Configuration (CampusCoin AI Chatbot & Dynamic Insights)
AI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (For Hybrid Google Authentication)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Backend Firebase Admin SDK
FIREBASE_PROJECT_ID=your_firebase_project_id

# ==============================================================================
# Google AdSense & Ads Monetization Configuration (Real-Time Live Ads)
# ==============================================================================
# Put your Google AdSense Publisher ID / API Key here (e.g. ca-pub-1234567890123456 or pub-1234567890123456)
VITE_ADS_API_KEY=ca-pub-1234567890123456
VITE_ADSENSE_CLIENT_ID=ca-pub-1234567890123456

# Ad Slots (Obtain from Google AdSense Dashboard -> Ads -> By ad unit)
VITE_ADSENSE_SLOT_DASHBOARD=1029384756
VITE_ADSENSE_SLOT_TRANSACTIONS=2039485761
VITE_ADSENSE_SLOT_REPORTS=3049586712

# Ad Mode: Set to "off" for Real-Time Live Ads, or "on" for sandbox test ads
VITE_ADSENSE_TEST_MODE=off

